{
  "name": "bidstrat-agent-desktop",
  "version": "1.0.0",
  "description": "竞策智能体桌面端 — 本地一体化运行时或远程控制台",
  "homepage": "https://github.com/hckj/bidStrat-agent",
  "author": {
    "name": "竞策智能体",
    "email": "dev@bidstrat.local"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.bidstrat.agent",
    "productName": "BidStratAgent",
    "copyright": "Copyright © 2026 竞策智能体",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "bidstrat-agent-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "竞策智能体",
      "artifactName": "bidstrat-agent-setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "bidstrat-agent-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "竞策智能体 <dev@bidstrat.local>",
      "vendor": "竞策智能体",
      "synopsis": "自进化标书 Agent 桌面端",
      "artifactName": "bidstrat-agent-${version}-linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "35.5.1",
    "electron-builder": "25.1.8"
  }
}
