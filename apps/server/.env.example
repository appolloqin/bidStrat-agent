# ===== 服务 =====
PORT=3000
NODE_ENV=development

# ===== 数据库 =====
# DB_TYPE=sqlite 时使用内嵌 SQLite（无需额外安装，自动创建数据库文件）
# DB_TYPE=mysql 时使用 MySQL 8
DB_TYPE=sqlite
# SQLite 数据文件路径（相对路径基于启动时的工作目录；不存在会自动创建目录与文件）
SQLITE_FILE=data/dev.db
# 以下仅 MySQL 生效
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bidstrat

# ===== 认证与加密 =====
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
# 用于加密数据库中的模型 API Key（AES-256-GCM）；留空则回退 JWT_SECRET。
# 生产环境务必单独设置并妥善保管；变更后将无法解密历史密钥。
APP_SECRET=

# ===== 大模型默认值 =====
# 模型配置优先从数据库 t_llm_config 读取（管理后台可改，API Key 加密存储）。
# 以下为回退默认值：数据库未配置时使用；LLM_API_KEY 留空则启用离线 Mock。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ===== LLM 自适应超时/降级 =====
# 单次请求基础超时（分级递增起点，秒）
LLM_TIMEOUT_MS=120000
# 超时后重试次数上限（每次超时放大 LLM_TIMEOUT_MUL 倍，直到预算上限）
LLM_MAX_RETRIES=3
# 超时放大倍数：120s → 240s → 480s → 960s
LLM_TIMEOUT_MUL=2
# 单次 chat() 全部分支累计总时长硬预算（毫秒）；超过即抛异常，不再无限等待。
# 40 分钟 = 2400000
LLM_MAX_TOTAL_MS=2400000
# LLM 并发上限（1 = 串行）。观测到连续超时后会自动降级为串行缓解拥塞。
LLM_CONCURRENCY=1

# ===== 其他 =====
UPLOAD_DIR=uploads
# 由后端托管的前端静态目录（桌面端本地模式使用）
WEB_DIST=
# 是否跳过人工断点自动续跑
AGENT_AUTO_CONTINUE=true
